generator kysely {
  provider        = "prisma-kysely"
  previewFeatures = ["views", "partialIndexes"]
  output          = "../src/db"
  banner          = "// This file was auto generated by prisma-kysely, do not edit."
  enumFileName    = "enums.ts"
  fileName        = "types.ts"
}

datasource db {
  provider = "postgresql"
}

enum ServiceRewardsActorParameterType {
  MIN_LOT_ALPHA_NUMERATOR
  MIN_LOT_ALPHA_DENOMINATOR
  MIN_LOT_FLOOR
  PRICE_BAND_BPS
  REGISTRATION_CUTOFF_EPOCHS
}

model application_config {
  id                 Int    @id @default(1)
  activation_epoch   BigInt
  epochs_per_quarter BigInt
}

model indexer_state {
  contract_address String   @id
  end_block        BigInt
  last_run_date    DateTime
  version          Int
}

model service_rewards_actor_parameter {
  parameter_type   ServiceRewardsActorParameterType
  parameter_value  Decimal
  update_epoch     BigInt
  update_log_index Int
  update_tx_hash   String

  @@id([parameter_type, update_epoch, update_log_index])
}

model service_orchestrator {
  id                   String  @id

  admissions    service_orchestrator_admission[]
  service_pairs service_pair[]
}

model service_orchestrator_admission {
  service_orchestrator_id String
  wallet                  String
  admission_epoch         BigInt
  admission_log_index     Int
  admission_tx_hash       String
  removal_epoch           BigInt?
  removal_log_index       Int?
  removal_tx_hash         String?

  service_orchestrator service_orchestrator @relation(fields: [service_orchestrator_id], references: [id])

  @@id([service_orchestrator_id, admission_epoch, admission_log_index])
  @@unique([service_orchestrator_id], where: { removal_epoch: null })
}

model service_pair {
  service_orchestrator_id String
  payer                   String
  operator                String
  from_epoch              BigInt
  from_log_index          Int
  to_epoch                BigInt?
  to_log_index            Int?
  binding_epoch           BigInt
  binding_tx_hash         String
  unbinding_epoch         BigInt?
  unbinding_tx_hash       String?
  service_orchestrator    service_orchestrator @relation(fields: [service_orchestrator_id], references: [id], onUpdate: Cascade)

  @@id([payer, operator, from_epoch, from_log_index])
  @@index([service_orchestrator_id, payer, operator])
}

model service_orchestrator_quarterly_volume {
  service_orchestrator_id String
  quarter_num             Int
  volume_atto_usd         Decimal
  is_correction           Boolean
  posting_epoch           BigInt
  posting_log_index       Int
  posting_tx_hash         String

  @@id([service_orchestrator_id, quarter_num, posting_epoch, posting_log_index])
}

model quarter_bound_volume {
  quarter_num     Int     @id
  volume_atto_usd Decimal
  epoch           BigInt
  tx_hash         String
}

model whitelisted_token {
  token_address        String
  token_decimals       Int
  token_symbol         String
  admittance_epoch     BigInt
  admittance_log_index Int
  admittance_tx_hash   String
  removal_epoch        BigInt?
  removal_log_index    Int?
  removal_tx_hash      String?

  @@id([token_address, admittance_epoch, admittance_log_index])
}

model filecoin_pay_contract {
  contract_address     String
  admittance_epoch     BigInt
  admittance_log_index Int
  admittance_tx_hash   String
  removal_epoch        BigInt?
  removal_log_index    Int?
  removal_tx_hash      String?

  @@id([contract_address, admittance_epoch, admittance_log_index])
}

model filecoin_pay_rail {
  filecoin_pay_contract_address String
  tx_hash                       String
  log_index                     Int
  operator                      String
  rail_id                       Decimal                @db.Decimal(78, 0)
  token                         String
  validator                     String
  payee                         String
  payer                         String
  settlements                   filecoin_pay_payment[]

  @@id([filecoin_pay_contract_address, rail_id])
  @@index(rail_id)
  @@index(token)
  @@index([payer, operator])
}

model filecoin_pay_payment {
  id                            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filecoin_pay_contract_address String
  tx_hash                       String
  log_index                     Int
  net_payee_amount              Decimal           @db.Decimal(78, 0)
  network_fee                   Decimal           @db.Decimal(78, 0)
  one_time                      Boolean
  operator_commission           Decimal           @db.Decimal(78, 0)
  rail_id                       Decimal           @db.Decimal(78, 0)
  settled_at_epoch              BigInt
  total_amount                  Decimal           @db.Decimal(78, 0)
  rail                          filecoin_pay_rail @relation(fields: [filecoin_pay_contract_address, rail_id], references: [filecoin_pay_contract_address, rail_id])

  @@index([filecoin_pay_contract_address, rail_id, settled_at_epoch])
}

model filecoin_pay_fee_auction {
  id                            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filecoin_pay_contract_address String
  tx_hash                       String
  log_index                     Int
  amount_actual                 Decimal @db.Decimal(78, 0)
  fil_burned                    Decimal @db.Decimal(78, 0)
  token_address                 String
  auctioned_at_epoch            BigInt
}

view qualified_price_periods_mv {
  quarter_num    Int
  epoch          BigInt
  log_index      Int
  lot_atto_usd   Decimal
  claim_atto_fil Decimal
  claim_tx_hash  String

  @@unique([quarter_num, epoch, log_index])
}
